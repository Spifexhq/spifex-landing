# Public site URL used for canonical URLs, sitemap and Open Graph.
SITE_URL=https://www.spifex.com

# Search engine verification (optional).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Meta Pixel (browser). Leave empty to disable tracking.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (server-only). Leave empty to disable CAPI.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
